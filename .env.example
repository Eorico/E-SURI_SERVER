# Supabase (Project Settings > API)
#
# Every Supabase credential lives here and only here. The frontend is given no
# Supabase URL and no Supabase key — it is configured with this API's address
# alone — so this service makes every call to Supabase on the browser's behalf.
#
#   ANON_KEY      the sign-in and refresh grants, so a user's token carries
#                 only their own privileges
#   SERVICE_KEY   administrative work (creating and deleting auth users) and
#                 Storage; bypasses row-level security, so it never signs a
#                 user in
#   JWT_SECRET    verifies the access token on every incoming request
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_KEY=...
SUPABASE_JWT_SECRET=...

# Direct Postgres connection (Project Settings > Database)
DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173
ANSWER_SHEET_BUCKET=answer-sheets
