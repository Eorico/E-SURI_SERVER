# ---------------------------------------------------------------------------
# MongoDB
#
# The only database credential in the system, and it lives here alone. The
# frontend is given no database URI and no key - it is configured with this
# API's address alone - so this service makes every call to MongoDB on the
# browser's behalf.
#
# Atlas: Database > Connect > Drivers, then copy the connection string.
#   - the password must be percent-encoded if it contains @ : / ? # [ ] or %
#   - this machine's IP has to be on the access list (Network Access), or the
#     connection times out with no useful message
#
# Answer-sheet images live in GridFS inside this same cluster, so storage is
# shared with the records. A free M0 cluster holds 512MB in total; sheets are
# recompressed on upload (see below), which is what makes that workable.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=esuri

# ---------------------------------------------------------------------------
# Authentication
#
# This server issues and verifies its own tokens. There is no sign-in provider
# any more, so JWT_SECRET is what every access and refresh token is signed
# with - an empty or guessable value lets anyone mint a token for any account,
# an administrator's included. The server refuses to start in production
# without at least 32 characters.
#
# Generate one, and do not reuse it between deployments:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173
ANSWER_SHEET_BUCKET=answer-sheets

# ---------------------------------------------------------------------------
# Email (confirmation + password reset)
#
# The code and the link are both minted, signed and sent by this server, so the
# wording, the sender and the expiry all live in the repository rather than in
# somebody else's dashboard.
#
# With EMAIL_ENABLED=false nothing is mailed and the code is written to the log
# instead - which is how you register an account on a machine with no SMTP.
#
# For Gmail: enable 2-Step Verification on the account, then create an App
# Password (Google Account > Security > App passwords) and use that 16-character
# value as SMTP_PASSWORD. A normal account password is rejected.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=you@gmail.com
SMTP_FROM_NAME=E-SURI

# Where a confirmation or reset link sends the person afterwards.
PUBLIC_APP_URL=http://localhost:8080

# This API's own address, as a browser reaches it.
#
# Needed because an answer-sheet image link now points here rather than at a
# storage provider: GridFS has no URL of its own, so the API serves the bytes
# and the link has to be absolute - a relative one would resolve against the
# frontend's origin and 404.
PUBLIC_API_URL=http://localhost:8000

# AI template mapping (admin template upload)
#
# When an administrator uploads a new DepEd workbook, the shape has usually
# moved: rows shift, sheets are renamed, a column is added. The analyzer works
# out where everything lives so the exporter keeps writing into the right
# cells without a code change.
#
# WHAT IS SENT: a structure digest only - sheet names, cell labels, formula
# shapes, merged ranges, and per-row counts of how many cells hold numbers.
# No learner name, no score, and no answer ever leaves this server. See
# utils/omr/template_analyzer.py (build_digest) for exactly what is built.
#
# Leave OPENAI_API_KEY empty to use the built-in heuristic analyzer instead,
# which maps the supplied templates correctly on its own and costs nothing.
# The AI is the fallback for a layout the heuristics do not recognise.
#
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Performance — every one of these has a working default in api/core/config.py.
# Set them only to match your cluster's limits or to tune under real load.
# ---------------------------------------------------------------------------
# Connections this process keeps open. Counted across EVERY process you run:
# two workers at 20 each is 40 connections, and a free M0 cluster allows 500.
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=0

# Retire an idle connection before Atlas drops it at the far end. One closed
# remotely costs a failed round trip before it is replaced.
# MONGO_MAX_IDLE_TIME_MS=900000

# Fail a request rather than hang when the cluster cannot be reached.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
# MONGO_CONNECT_TIMEOUT_MS=8000

# Ceiling on a single operation. A report that cannot finish in this long
# should be narrowed, not waited on.
# MONGO_SOCKET_TIMEOUT_MS=20000

# Answer-sheet recompression. GridFS shares the cluster's 512MB with every
# record, and a 3MB phone photo holds far more detail than the OMR grid needs.
# At these settings a sheet lands near 200KB instead - roughly 6,000 sheets per
# 512MB rather than 1,200. Set SHEET_RECOMPRESS=false to keep originals.
# SHEET_RECOMPRESS=true
# SHEET_MAX_EDGE_PX=1600
# SHEET_JPEG_QUALITY=72
# SHEET_GRAYSCALE=true

# Token lifetimes. The access token is an hour, as it was before, so the
# client's refresh timing is unchanged. Refresh tokens are recorded and
# rotated, so signing out really ends a session.
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=1209600
# SIGNUP_CODE_TTL_SECONDS=900
# PASSWORD_RESET_TTL_SECONDS=3600

# Requests allowed per five-minute window, per caller. AUTH is deliberately
# tight (password guessing); SESSION covers token renewal, which is routine and
# happens once per token lifetime per open tab.
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_SESSION=120
# RATE_LIMIT_READ=300
# RATE_LIMIT_WRITE=100
# RATE_LIMIT_SCAN=60
# RATE_LIMIT_EXPORT=10
